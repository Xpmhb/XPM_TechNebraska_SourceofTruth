  "ratio_rule": {
    "rule": "80/20 Brand Color Balance",
    "description": "80% of any layout must consist of neutral foundations (Obsidian Black or Off-White) and 20% vibrant color pops (Electric Blue, Goldenrod, Ice Cyan)."
  },
  "typography": {
    "primary_display_headline": {
      "family": "Gilgan",
      "fallback": "'Work Sans', 'Helvetica Neue', Arial, sans-serif",
      "weights": [
        "400 Regular"
      ],
      "local_font_file": "assets/fonts/Gilgan-Regular.ttf",
      "usage": "Primary campaign headlines, keynote speaker names, hero announcement titles"
    },
    "primary_body_and_subhead": {
      "family": "Work Sans",
      "fallback": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "weights": [
        "300 Light",
        "400 Regular",
        "500 Medium",
        "600 SemiBold",
        "700 Bold"
      ],
      "google_fonts_url": "https://fonts.googleapis.com/css2?family=Work+Sans:wght@300;400;500;600;700&display=swap",
      "usage": "Body copy, deck text, navigation, supporting subtitles, executive quotes"
    },
    "secondary_accents_and_buttons": {
      "family": "Space Grotesk",
      "fallback": "'SF Pro Display', -apple-system, sans-serif",
      "weights": [
        "400 Regular",
        "500 Medium",
        "700 Bold"
      ],
      "google_fonts_url": "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap",
      "usage": "Metric callouts, section numbers, bug badges, CTA buttons, technical labels"
    }
  },
  "layout": {
    "radii": {
      "sm": "8px",
      "md": "14px",
      "lg": "20px",
      "full": "9999px"
    },
    "shadows": {
      "subtle": "0 10px 30px rgba(0, 0, 0, 0.4)",
      "glow_blue": "0 0 40px rgba(0, 128, 199, 0.25)",
      "glow_gold": "0 0 30px rgba(255, 185, 0, 0.2)"
    }
  }
